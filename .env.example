# Copy this file to .env and fill in your own values. .env is ignored by git.

# SQL Server SA password: at least 8 characters with upper case, lower case, a digit, and a symbol.
# Avoid "$", which Docker Compose treats as variable interpolation.
MSSQL_SA_PASSWORD=

# Host port for SQL Server. Change it if 1433 is already taken.
MSSQL_PORT=1433
